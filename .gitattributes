# Binary art assets go through LFS. Model weights (base models, HF cache)
# stay OUT of the repo entirely; only curated outputs and trained LoRAs
# small enough to version belong here.
art/**/*.png filter=lfs diff=lfs merge=lfs -text
art/**/*.jpg filter=lfs diff=lfs merge=lfs -text
art/**/*.webp filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
imagegen/training/dataset/**/*.png filter=lfs diff=lfs merge=lfs -text
# Raw session JSONLs: the exact substrate for checkpoint-replay under
# planning/attribution-review.md. The Jan 2026 JSONLs were lost before
# anyone thought to archive them; these are kept so the Fable 5
# entities can be replayed rather than reconstructed.
transcripts/raw/*.jsonl.gz filter=lfs diff=lfs merge=lfs -text
